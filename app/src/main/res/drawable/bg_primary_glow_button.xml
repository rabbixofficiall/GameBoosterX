<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#00C2A8" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#7CFFEA" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#00F5D4" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#B3FFF6" />
        </shape>
    </item>
</selector>
