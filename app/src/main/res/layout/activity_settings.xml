<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME BOOSTER SETTINGS"
            android:textColor="#00F5D4"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cyberpunk control and optimization panel"
            android:textColor="#8EA2B4"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cyber_card"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/shizukuStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shizuku Status: Checking..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/requestShizukuButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Grant Shizuku Permission"
                android:textAllCaps="false"
                android:textColor="#031012"
                android:background="@drawable/bg_primary_glow_button"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cyber_card"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DPI Control"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dpiInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter DPI (example 480)"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A8A99"
                android:inputType="number"
                android:background="@drawable/bg_cyber_input"
                android:padding="14dp"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/applyDpiButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Apply DPI"
                android:textAllCaps="false"
                android:textColor="#031012"
                android:background="@drawable/bg_primary_glow_button"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/resetDpiButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Reset DPI"
                android:textAllCaps="false"
                android:textColor="#D7FFFA"
                android:background="@drawable/bg_secondary_glow_button"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/currentDpiButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Read Current DPI"
                android:textAllCaps="false"
                android:textColor="#D7FFFA"
                android:background="@drawable/bg_secondary_glow_button"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cyber_card"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Boost"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cloudflareDnsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Use Cloudflare DNS"
                android:textAllCaps="false"
                android:textColor="#031012"
                android:background="@drawable/bg_primary_glow_button"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/googleDnsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Use Google DNS"
                android:textAllCaps="false"
                android:textColor="#D7FFFA"
                android:background="@drawable/bg_secondary_glow_button"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/disableDnsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Disable Private DNS"
                android:textAllCaps="false"
                android:textColor="#D7FFFA"
                android:background="@drawable/bg_secondary_glow_button"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/dnsStateButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Read DNS State"
                android:textAllCaps="false"
                android:textColor="#D7FFFA"
                android:background="@drawable/bg_secondary_glow_button"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cyber_card"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Optimization"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/dynamicSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dynamic Optimization"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp" />

            <Switch
                android:id="@+id/touchSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Touch Boost"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/optimizeButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Run Optimization"
                android:textAllCaps="false"
                android:textColor="#031012"
                android:background="@drawable/bg_primary_glow_button"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cyber_card"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cleaner Tools"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/junkCleanButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Clean Junk Files"
                android:textAllCaps="false"
                android:textColor="#031012"
                android:background="@drawable/bg_primary_glow_button"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/hiddenCacheButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Scan Hidden Cache"
                android:textAllCaps="false"
                android:textColor="#D7FFFA"
                android:background="@drawable/bg_secondary_glow_button"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
